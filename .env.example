# Telegram Bot Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Note: Session password is entered interactively on every `npm start` run (not stored in .env or config.json)

# Optional comma-separated Telegram numeric user IDs allowed to use the bot (blank = anyone with the current run password)
ALLOWED_TELEGRAM_USER_IDS=

# Number of latest messages (X) shown when viewing chat history (fixed in bot; configured via setup)
DEFAULT_HISTORY_COUNT=6

# Default Gemini model & reasoning effort level (low | medium | high | xhigh | max)
DEFAULT_AGENT_MODEL=gemini-3.8-flash-high
DEFAULT_AGENT_MODEL_LEVEL=high

# Jenkins Configuration (optional)
JENKINS_BASE_URL=https://jenkins.example.com
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB_PREFIX=
