{
  "name": "mobile-agent-control",
  "version": "3.1.0",
  "description": "Mobile Agent Control (mac.app / MAC) — Native macOS menu bar app to remotely control local AI coding Workspaces (Google Antigravity, Gemini & Claude), Git branches, and Staging-to-Prod Jenkins CI/CD via Telegram with 2-minute GUI setup",
  "type": "module",
  "license": "MIT",
  "author": "DOMONK Factory (https://domonk.com)",
  "homepage": "https://github.com/madmicrowave/mobile-agent-control#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madmicrowave/mobile-agent-control.git"
  },
  "bugs": {
    "url": "https://github.com/madmicrowave/mobile-agent-control/issues"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "macos",
    "macos-app",
    "menubar-app",
    "swift",
    "swiftui",
    "ai-coding-agent",
    "telegram-bot",
    "google-gemini",
    "gemini",
    "claude-opus",
    "antigravity",
    "antigravity-ide",
    "remote-workspace",
    "mobile-coding",
    "chatops",
    "git-automation",
    "jenkins",
    "jenkins-ci",
    "ci-cd",
    "devops",
    "domonk"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "[ -d ./mac.app ] || zsh scripts/build-app.sh; open ./mac.app",
    "build:app": "zsh scripts/build-app.sh",
    "cli": "node src/bot.mjs",
    "setup": "node src/setup.mjs",
    "add-workspace": "node src/setup.mjs add-ide",
    "update-jenkins": "node src/setup.mjs update-jenkins",
    "test-jenkins": "node src/setup.mjs test-jenkins",
    "stop": "node src/service.mjs stop",
    "test:node": "node --test test/*.test.mjs",
    "test:mac": "zsh scripts/run-mac-tests.sh",
    "test": "node --test test/*.test.mjs && ([ \"$(uname -s)\" != \"Darwin\" ] || zsh scripts/run-mac-tests.sh)"
  }
}
