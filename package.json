{
  "name": "mobile-agent-control",
  "version": "3.3.0",
  "description": "Mobile Agent Control (mac.app / MAC) — Free open-source native Swift & SwiftUI macOS menu bar + Dock application to remotely control local AI coding Workspaces (Gemini, Claude, DeepSeek, OpenAI, Qwen, Ollama/LM Studio local models via Terminal CLI or Direct API), Git monorepo pushes, and Single/Multi-Environment Jenkins CI/CD via Telegram",
  "type": "module",
  "license": "MIT",
  "author": "DOMONK Factory (https://domonk.com)",
  "homepage": "https://github.com/madmicrowave/mobile-agent-control#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madmicrowave/mobile-agent-control.git"
  },
  "bugs": {
    "url": "https://github.com/madmicrowave/mobile-agent-control/issues"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "macos",
    "macos-app",
    "macos-application",
    "menubar-app",
    "status-bar",
    "swift",
    "swiftui",
    "appkit",
    "ai-coding-agent",
    "ai-coding",
    "telegram",
    "telegram-bot",
    "google-gemini",
    "gemini",
    "claude-opus",
    "claude-sonnet",
    "deepseek",
    "deepseek-r1",
    "openai",
    "qwen",
    "ollama",
    "lm-studio",
    "vllm",
    "local-ai",
    "offline-ai",
    "aider",
    "antigravity",
    "antigravity-ide",
    "remote-development",
    "remote-workspace",
    "mobile-coding",
    "chatops",
    "git-automation",
    "monorepo",
    "jenkins",
    "jenkins-ci",
    "ci-cd",
    "open-source",
    "domonk"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "[ -d ./mac.app ] || zsh scripts/build-app.sh; open ./mac.app",
    "build:app": "zsh scripts/build-app.sh",
    "cli": "node src/bot.mjs",
    "setup": "node src/setup.mjs",
    "add-workspace": "node src/setup.mjs add-workspace",
    "jenkins-add-user": "node src/setup.mjs jenkins-add-user",
    "jenkins-test-access": "node src/setup.mjs jenkins-test-access",
    "github-add-user": "node src/setup.mjs github-add-user",
    "github-test-access": "node src/setup.mjs github-test-access",
    "google-cloud-add-user": "node src/setup.mjs google-cloud-add-user",
    "google-cloud-test-access": "node src/setup.mjs google-cloud-test-access",
    "ai-engines": "node src/setup.mjs ai-engines",
    "stop": "node src/service.mjs stop",
    "test:node": "node --test test/*.test.mjs",
    "test:mac": "zsh scripts/run-mac-tests.sh",
    "test": "node --test test/*.test.mjs && ([ \"$(uname -s)\" != \"Darwin\" ] || zsh scripts/run-mac-tests.sh)"
  }
}
