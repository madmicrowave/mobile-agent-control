{
  "name": "phone-agent-control",
  "version": "2.4.0",
  "description": "Control local macOS AI coding agents (Google Antigravity IDE, Gemini & Claude Opus), Git branches, and Staging-to-Production Jenkins CI/CD deployments from Telegram — zero open ports",
  "type": "module",
  "license": "MIT",
  "author": "DOMONK Factory (https://domonk.com)",
  "homepage": "https://github.com/madmicrowave/phone-agent-control#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/madmicrowave/phone-agent-control.git"
  },
  "bugs": {
    "url": "https://github.com/madmicrowave/phone-agent-control/issues"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "macos",
    "ai-coding-agent",
    "telegram-bot",
    "google-gemini",
    "gemini",
    "claude-opus",
    "antigravity",
    "antigravity-ide",
    "remote-ide",
    "mobile-coding",
    "chatops",
    "git-automation",
    "jenkins",
    "jenkins-ci",
    "ci-cd",
    "devops",
    "domonk"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/bot.mjs",
    "setup": "node src/setup.mjs",
    "add-ide": "node src/setup.mjs add-ide",
    "update-jenkins": "node src/setup.mjs update-jenkins",
    "test-jenkins": "node src/setup.mjs test-jenkins",
    "stop": "node src/service.mjs stop",
    "test": "node --test test/*.test.mjs"
  }
}
